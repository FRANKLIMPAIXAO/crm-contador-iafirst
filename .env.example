# =============================================
# CRM Contador IA First — .env
# Copie para .env e preencha os valores reais
# =============================================

NODE_ENV=development
PORT=3000

# =============================================
# Postgres
# =============================================
# Local (docker compose):
DATABASE_URL=postgresql://crm:crmpass@localhost:5432/crm
# Produção (EasyPanel — container interno):
# DATABASE_URL=postgresql://crm:senha_forte@crm-db:5432/crm

# =============================================
# JWT — gere uma string aleatória LONGA
# Exemplo: openssl rand -base64 64
# =============================================
JWT_SECRET=troque-pra-string-aleatoria-grande-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=7d

# =============================================
# Anthropic Claude
# =============================================
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_TRIAGEM=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_RASCUNHO=claude-sonnet-4-5

# =============================================
# Evolution API (WhatsApp)
# =============================================
EVOLUTION_API_URL=https://evolution.suavps.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_DEFAULT=pac-vendas
EVOLUTION_WEBHOOK_SECRET=string-aleatoria-pra-validar-webhook

# =============================================
# SEXTA-FEIRA Integration
# Token JWT específico que a SEXTA usa pra consultar este CRM via API
# =============================================
SEXTA_API_TOKEN=

# =============================================
# CORS
# =============================================
CORS_ORIGIN=http://localhost:5173
# em prod: https://crm.franklimpaixao.com.br
